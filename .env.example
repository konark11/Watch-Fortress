# Copy to .env and adjust before running `docker compose up`

# --- Auth ---
VULN_JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- Database (default: portable SQLite, no config needed) ---
# VULN_DATABASE_URL=postgresql://vuln:vuln@postgres:5432/vuln_platform

# --- AI Assistant (RAG) mode: template | ollama | openrouter | online ---
VULN_RAG_MODE=template
VULN_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
VULN_OLLAMA_BASE_URL=http://ollama:11434
VULN_OLLAMA_MODEL=llama3
# VULN_ONLINE_LLM_BASE_URL=https://api.openai.com/v1
# VULN_ONLINE_LLM_API_KEY=
# VULN_ONLINE_LLM_MODEL=gpt-4o-mini

# --- OpenRouter (enter your key locally; only :free model IDs are accepted) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free

# --- OpenVAS/GVM (leave blank to disable that scanner) ---
GVM_HOST=
GVM_PORT=9390
GVM_USERNAME=
GVM_PASSWORD=
# GVM_SCAN_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea   # "Full and fast" (default)
# GVM_SCANNER_ID=08b69003-5fc2-4037-a479-93b440211c73        # "OpenVAS Default" (default)

# --- Nessus (leave blank to disable that scanner) ---
NESSUS_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=



Set-Location 'D:\Watch-Fortress\frontend'; npm run dev -- --host 127.0.0.1 --port 5173

Set-Location 'D:\Watch-Fortress\backend'; python -m uvicorn main:app --host 127.0.0.1 --port 8000