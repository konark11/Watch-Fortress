# Copy to .env and adjust before running `docker compose up`

# --- Auth ---
VULN_JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- Database (default: portable SQLite, no config needed) ---
# VULN_DATABASE_URL=postgresql://vuln:vuln@postgres:5432/vuln_platform
# PostgreSQL deployments use persisted pgvector + SQL hybrid retrieval.
RAG_RETRIEVAL_BACKEND=auto
RAG_VECTOR_CANDIDATE_K=50
RAG_LEXICAL_CANDIDATE_K=50
RAG_FUSION_K=50
RAG_RERANK_K=20
# Local cross-encoder reranking is CPU-intensive; enable only when needed.
RAG_RERANK_ENABLED=0
RAG_FINAL_EVIDENCE_K=5
RAG_INDEXING_BATCH_SIZE=64
# Full rebuilds are administrator-only and disabled by default.
RAG_FULL_REINDEX_ENABLED=0

# --- AI Assistant (RAG) ---
# Canonical provider setting: template | ollama | groq | openrouter | online
RAG_GENERATION_PROVIDER=groq
RAG_GENERATION_BASE_URL=https://api.openai.com/v1
RAG_GENERATION_API_KEY=
RAG_GENERATION_MODEL=openai/gpt-oss-120b
# Network timeout and retry budget for hosted/local HTTP generation.
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_RETRIES=2
# Preload the local embedding model during FastAPI startup to avoid cold-request latency.
RAG_PRELOAD_EMBEDDINGS=true
# Maximum time for the optional NVD fallback lookup.
RAG_NVD_LOOKUP_TIMEOUT_SECONDS=3
# Groq uses GROQ_MODEL when set; otherwise RAG_GENERATION_MODEL is used.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Optional comma-separated pool; numbered keys remain supported.
GROQ_API_KEYS=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Backward-compatible model alias used by older local .env files.
# ANSWER_MODEL=
# Legacy VULN_* names remain supported when canonical values are absent.
VULN_RAG_MODE=online
VULN_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional NVD API key; keep the real value only in .env or the deployment secret store.
NVD_API_KEY=
VULN_OLLAMA_BASE_URL=http://ollama:11434
VULN_OLLAMA_MODEL=llama3
# VULN_ONLINE_LLM_BASE_URL and VULN_ONLINE_LLM_API_KEY are deprecated aliases.

# --- Local RAG models (CPU) ---
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_REVISION=
RAG_ALLOW_MODEL_DOWNLOAD=0
# Set to 1 only when downloading uncached model weights is approved.
RAG_JEV_MODE=disabled
RAG_JEV_MODEL=jev-latest

# --- OpenRouter (enter your key locally; only :free model IDs are accepted) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_RERANK_MODEL=

# --- OpenVAS/GVM (leave blank to disable that scanner) ---
GVM_HOST=
GVM_PORT=9390
GVM_USERNAME=
GVM_PASSWORD=
# GVM_SCAN_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea   # "Full and fast" (default)
# GVM_SCANNER_ID=08b69003-5fc2-4037-a479-93b440211c73        # "OpenVAS Default" (default)

# --- Nessus (leave blank to disable that scanner) ---
NESSUS_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# --- Durable PostgreSQL jobs (production) ---
# SQLite remains portable for single-process development; it is not a
# multi-worker durable queue.
JOB_WORKER_ENABLED=0
JOB_WORKER_ID=
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=300
JOB_MAX_CONCURRENCY=1
JOB_RETRY_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_STALE_SECONDS=120
SCHEDULER_POLL_INTERVAL_SECONDS=30

# --- Assistant conversation retention ---
# Finite defaults prevent indefinite storage. Changes apply to new rows.
ASSISTANT_CONVERSATION_RETENTION_DAYS=90
ASSISTANT_MESSAGE_RETENTION_DAYS=90
ASSISTANT_MEMORY_RETENTION_DAYS=90
ASSISTANT_CONTEXT_MAX_MESSAGES=12
ASSISTANT_CONTEXT_MAX_CHARACTERS=12000
ASSISTANT_MEMORY_MAX_ITEMS=20
ASSISTANT_RETENTION_PURGE_ENABLED=true
ASSISTANT_RETENTION_PURGE_BATCH_SIZE=100

# --- Optional OpenTelemetry / evaluation observability ---
OTEL_SERVICE_NAME=watch-fortress
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
RAG_EVALUATION_RESULTS_DIR=backend/experiments/results



Set-Location 'D:\Watch-Fortress\frontend'; npm run dev -- --host 127.0.0.1 --port 5173

Set-Location 'D:\Watch-Fortress\backend'; python -m uvicorn main:app --host 127.0.0.1 --port 8000